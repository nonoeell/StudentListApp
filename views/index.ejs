<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student List App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-3">
        <h1 class="mb-3">Student List App</h1>

        <a href="/student" class="btn btn-primary mb-4">Add new student</a>

        <h2 class="mb-3">Students from Student List App Database</h2>

        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Student Image</th>
                    <th>Dob</th>
                    <th>Contact</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% students.forEach(student => { %>
                    <tr>
                        <td><%= student.name %></td>
                        <td>
                            <img src="<%= student.image %>" alt="<%= student.name %>" width="100" height="100" style="object-fit: cover;">
                        </td>
                        <td><%= new Date(student.dob).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' }) %></td>
                        <td><%= student.contact %></td>
                        <td>
                            <a href="/student/<%= student.studentid %>" class="btn btn-info btn-sm">View</a>
                            <a href="/editStudent/<%= student.studentid %>" class="btn btn-warning btn-sm">Edit</a>
                            <form action="/deleteStudent/<%= student.studentid %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>