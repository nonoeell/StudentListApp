<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-3">
        <h1 class="mb-3"><%= student.name %></h1>

        <img src="<%= student.image %>" alt="<%= student.name %>" width="200" class="mb-3">

        <p><strong>DOB:</strong> <%= new Date(student.dob).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' }) %></p>
        <p><strong>Contact:</strong> <%= student.contact %></p>

        <a href="/editStudent/<%= student.studentid %>" class="btn btn-warning">Edit</a>

        <form action="/deleteStudent/<%= student.studentid %>" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>

        <a href="/" class="btn btn-secondary">Back</a>
    </div>
</body>
</html>